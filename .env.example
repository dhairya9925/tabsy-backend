# Supabase Public Keys (Required for Frontend)
# These will be bundled by Vite and are safe to be public.
VITE_SUPABASE_PROJECT_ID="your_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_anon_key"
VITE_SUPABASE_URL="https://your_project_id.supabase.co"

# Application URL (Use exact domain for prod)
VITE_APP_URL="http://localhost:8080"

# FastAPI Backend URL (Defaults to http://localhost:8000 in dev)
VITE_API_URL="http://localhost:8000"

# SECRETS (Required ONLY for Edge Functions and Drizzle Migrations)
# THESE MUST NEVER BE COMMITTED TO GIT OR PREFIXED WITH VITE_
RESEND_API_KEY="re_..."
DATABASE_URL="postgresql://postgres.[project_id]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"
